# Copy to .env (never committed). Leave MOVIES_PASSWORD empty for an open localhost server.
MOVIES_PASSWORD=
# OMDB_API_KEY=
# Weather on the home page (defaults: Moscow). Set YANDEX_WEATHER_KEY to use Yandex instead of Open-Meteo.
WEATHER_CITY=Москва
WEATHER_LAT=55.7558
WEATHER_LON=37.6173
WEATHER_TZ=Europe/Moscow
# YANDEX_WEATHER_KEY=
# Apple Health ingest from the Health Bridge iOS app: name=token pairs (the app sends Authorization: Bearer <token>)
HEALTH_TOKENS=iphone=change-me
# HEALTH_TZ=Europe/Moscow            # day boundaries for the health table (default: WEATHER_TZ)
# Background AI jobs use authenticated Codex CLI (see docs/ai.md).
# BOW_CODEX_MODEL=gpt-6.1-sol
# BOW_CODEX_EXTRACT_MODEL=gpt-6-luna
# BOW_CODEX_TIMEOUT=600
# HEALTH_MODEL=gpt-6.1-sol
# Roborock: ежедневная уборка в 10:30 МСК, сначала пылесос, потом швабра.
# Мониторинг ошибок станции работает независимо от включения расписания.
# VACUUM_SCHEDULE=on
# VACUUM_AT=10:30
# VACUUM_TZ=Europe/Moscow
# VACUUM_DAYS=0,1,2,3,4,5,6
# VACUUM_MODE=vac_then_mop
# VACUUM_CALENDAR=off
