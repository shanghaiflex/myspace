# Copy to .env (never committed). Leave MOVIES_PASSWORD empty for an open localhost server.
MOVIES_PASSWORD=
# OMDB_API_KEY=
# Weather on the home page (defaults: Moscow). Set YANDEX_WEATHER_KEY to use Yandex instead of Open-Meteo.
WEATHER_CITY=Москва
WEATHER_LAT=55.7558
WEATHER_LON=37.6173
WEATHER_TZ=Europe/Moscow
# YANDEX_WEATHER_KEY=
# Apple Health ingest from the Health Bridge iOS app: name=token pairs (the app sends Authorization: Bearer <token>)
HEALTH_TOKENS=iphone=change-me
# HEALTH_TZ=Europe/Moscow            # day boundaries for the health table (default: WEATHER_TZ)
# Hourly Claude note (scripts/health_review.sh): token from `claude setup-token`, or ANTHROPIC_API_KEY
# CLAUDE_CODE_OAUTH_TOKEN=
# HEALTH_MODEL=opus
